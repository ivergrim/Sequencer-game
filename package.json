{
  "name": "sequencing-runner",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node test/e2e/playthrough.mjs",
    "test:e2e:drift": "node test/e2e/drift.mjs",
    "test:e2e:patch1": "node test/e2e/patch1.mjs",
    "test:e2e:responsive": "node test/e2e/responsive.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.0"
  }
}
